ArrayList <Cuadrado> tubos;
Pelota bird;
PVector G = new PVector(0, 4);

void setup() {
  size(800, 600);
  tubos = new ArrayList <Cuadrado>();
  bird = new Pelota(100, height/2);
}

void draw() {
  background(255);

  float medioY = height / 2;


  if (tubos.size() == 0 || tubos.get(tubos.size() - 1).pos.x < width - 250) {
    float altoArriba = random(50, medioY);
    tubos.add(new Cuadrado(width, 0, 60, altoArriba));

    float inicioAbajo = random(medioY, height - 50);
    tubos.add(new Cuadrado(width, inicioAbajo, 60, height - inicioAbajo));
  }

  bird.addFuerza(G);
  bird.mover();
  borrarTubos();

  for (Cuadrado t : tubos) {
    t.mover();
    t.mostrar();
    if (t.colisiona(bird)) {
      perdio();
    }
  }

  if (bird.pos.y < 0 || bird.pos.y > height) {
    perdio();
  }

  bird.mostrar();
}

void keyPressed() {
  if (key == 'w') {
    bird.vel.y = 0;
    bird.addFuerza(new PVector(0, -7));
  }
}

void perdio() {
  tubos.clear();
  bird = new Pelota(100, height/2);
}

void borrarTubos() {
  for (int i = tubos.size()-1; i >= 0; i--) {
    if (tubos.get(i).pos.x < -70) {
      tubos.remove(i);
    }
  }
}
